# Copy to .env to override. All optional.
MQ_IMAGE_TAG=10.0.0.5-r1      # or 9.4.5.1-r1 (LTS) — both are exercised by the same pack
MQ_QMGR_NAME=QM1
MQ_ADMIN_PASSWORD=passw0rd    # must match stack/mq/secrets/mqAdminPassword
MQ_APP_PASSWORD=passw0rd      # must match stack/mq/secrets/mqAppPassword
ENV=lab
PRODUCER_RATE=5               # orders producer, messages/second
OTELCOL_TAG=0.161.0
PROM_TAG=v3.14.0
AM_TAG=v0.34.0
LOKI_TAG=3.7.7
TEMPO_TAG=2.10.1
GRAFANA_TAG=12.4.11
KAFKA_TAG=3.9.2                # apache/kafka, the reference-pack target (kafka 3.x); stack/kafka adds the JMX exporter 1.6.0
KAFKA_EXPORTER_TAG=v1.10.0     # danielqsj/kafka-exporter
CURL_TAG=8.22.0                # curlimages/curl: the grafana login canary and the JMX jar fetch stage
KAFKA_ORDERS_RATE=50           # kafka-gen, messages/second on topic orders (payments: KAFKA_PAYMENTS_RATE=10)
