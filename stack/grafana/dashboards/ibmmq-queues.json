              "type": "value",
              "options": {
                "0": {
                  "text": "INACTIVE / STOPPED",
                  "color": "#8B98A9"
                },
                "1": {
                  "text": "TRANSITION",
                  "color": "#F5B14C"
                },
                "2": {
                  "text": "RUNNING",
                  "color": "#3DD68C"
                }
