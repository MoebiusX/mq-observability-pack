        {
          "refId": "B",
          "expr": "rate(ibmmq_qmgr_mqput_mqput1_total{job=\"ibmmq-native\"}[2m])",
          "legendFormat": "mqput/s"
        },
        {
          "refId": "C",
          "expr": "rate(ibmmq_qmgr_destructive_get_total{job=\"ibmmq-native\"}[2m])",
