{
  "uid": "ibmmq-queues",
  "title": "IBM MQ — Queues & Channels",
  "tags": [
    "ibmmq",
    "pack"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "Pack alerts",
        "datasource": {
          "type": "prometheus",
          "uid": "prom"
        },
        "enable": true,
        "iconColor": "#d03b3b",
        "expr": "ALERTS{alertstate=\"firing\", pack=\"ibmmq\"}",
        "step": "10s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{severity}} {{queue}}"
      }
    ]
  },
  "links": [
    {
      "title": "IBM MQ folder",
      "type": "dashboards",
      "tags": [
        "ibmmq"
      ],
      "asDropdown": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "type": "timeseries",
      "title": "Depth by queue",
      "description": "binds_to: ref:queries.per_queue_depth",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ibmmq_queue_depth{job=\"ibmmq-exporter\"}",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "type": "timeseries",
      "title": "MAXDEPTH by queue",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ibmmq_queue_attribute_max_depth{job=\"ibmmq-exporter\"}",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "type": "timeseries",
      "title": "Put rate by queue",
      "description": "binds_to: ref:queries.per_queue_throughput",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue)(sum_over_time(ibmmq_queue_mqput_mqput1_count{job=\"ibmmq-exporter\"}[2m])) / 120",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "type": "timeseries",
      "title": "Get rate by queue",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue)(sum_over_time(ibmmq_queue_mqget_count{job=\"ibmmq-exporter\"}[2m])) / 120",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "type": "timeseries",
      "title": "Oldest message age by queue",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ibmmq_queue_oldest_message_age{job=\"ibmmq-exporter\"}",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "type": "timeseries",
      "title": "Queue time (short / long sample)",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ibmmq_queue_qtime_short{job=\"ibmmq-exporter\"}",
          "legendFormat": "{{queue}} short"
        },
        {
          "refId": "B",
          "expr": "ibmmq_queue_qtime_long{job=\"ibmmq-exporter\"}",
          "legendFormat": "{{queue}} long"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "µs",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "type": "timeseries",
      "title": "Open handles (input / output)",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ibmmq_queue_input_handles{job=\"ibmmq-exporter\"}",
          "legendFormat": "{{queue}} in"
        },
        {
          "refId": "B",
          "expr": "ibmmq_queue_output_handles{job=\"ibmmq-exporter\"}",
          "legendFormat": "{{queue}} out"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "type": "timeseries",
      "title": "Channel status (0 stopped · 1 transition · 2 running)",
      "description": "binds_to: ref:queries.per_channel_status",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (channel, type)(ibmmq_channel_status_squash{job=\"ibmmq-exporter\"})",
          "legendFormat": "{{channel}} ({{type}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 2,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "type": "timeseries",
      "title": "Channel messages / s (per-interval deltas ÷ 120 s)",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (channel)(sum_over_time(ibmmq_channel_messages{job=\"ibmmq-exporter\"}[2m])) / 120",
          "legendFormat": "{{channel}} msgs/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "type": "timeseries",
      "title": "Native endpoint: commits / MQI calls (qmgr-level)",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(ibmmq_qmgr_commit_total{job=\"ibmmq-native\"}[2m])",
          "legendFormat": "commits/s"
        },
        {
          "refId": "B",
          "expr": "rate(ibmmq_qmgr_mqput_mqput1_total{job=\"ibmmq-native\"}[2m])",
          "legendFormat": "mqput/s"
        },
        {
          "refId": "C",
          "expr": "rate(ibmmq_qmgr_destructive_get_total{job=\"ibmmq-native\"}[2m])",
          "legendFormat": "destructive get/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
