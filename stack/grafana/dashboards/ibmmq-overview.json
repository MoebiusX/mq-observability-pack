{
  "uid": "ibmmq-overview",
  "title": "IBM MQ — Overview (pack SLIs)",
  "tags": [
    "ibmmq",
    "pack",
    "slo"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "Pack alerts",
        "datasource": {
          "type": "prometheus",
          "uid": "prom"
        },
        "enable": true,
        "iconColor": "#d03b3b",
        "expr": "ALERTS{alertstate=\"firing\", pack=\"ibmmq\"}",
        "step": "10s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{severity}} {{queue}}"
      }
    ]
  },
  "links": [
    {
      "title": "IBM MQ folder",
      "type": "dashboards",
      "tags": [
        "ibmmq"
      ],
      "asDropdown": true
    }
