    {
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "type": "timeseries",
      "title": "Burn-rate / forecast alerts (1 = pending, 2 = firing)",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(2 * max by (alertname) (ALERTS{pack=\"ibmmq\", alertstate=\"firing\", burn_rate!=\"\"})) or max by (alertname) (ALERTS{pack=\"ibmmq\", alertstate=\"pending\", burn_rate!=\"\"})",
          "legendFormat": "{{alertname}}"
        },
        {
          "refId": "B",
          "expr": "(2 * max by (alertname) (ALERTS{pack=\"ibmmq\", alertstate=\"firing\", kind=\"forecast\"})) or max by (alertname) (ALERTS{pack=\"ibmmq\", alertstate=\"pending\", kind=\"forecast\"})",
          "legendFormat": "{{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 2,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
